def objective(trial):
    # Suggest hyperparameters from predefined sets
    changepoint_prior_scale = trial.suggest_categorical('changepoint_prior_scale', [0.01, 0.1, 0.5, 1.0])
    seasonality_prior_scale = trial.suggest_categorical('seasonality_prior_scale', [0.1, 1.0, 5.0, 10.0])
    changepoint_range = trial.suggest_categorical('changepoint_range', [0.8, 0.85, 0.9, 0.95])
    n_changepoints = trial.suggest_categorical('n_changepoints', [5, 10, 20, 30, 50])

    # Initialize Prophet with suggested hyperparameters
    model = Prophet(
        changepoint_prior_scale=changepoint_prior_scale,
        seasonality_prior_scale=seasonality_prior_scale,
        changepoint_range=changepoint_range,
        n_changepoints=n_changepoints
    )

    # Fit the model on the train set
    model.fit(train_data)

    # Make predictions on the validation set
    future = model.make_future_dataframe(periods=len(test_data))
    forecast = model.predict(future)

    # Evaluate predictions on the validation set
    validation_forecast = forecast[-len(test_data):]
    y_true = test_data['y'].values
    y_pred = validation_forecast['yhat'].values

    # Calculate metrics
    mse = mean_squared_error(y_true, y_pred)

    # Return the metric to be minimized
    return mse
